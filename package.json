{
  "name": "yarreader",
  "version": "1.0.1",
  "private": true,
  "description": "Crash-recoverable publication ingestion and portable static reader.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": "26.x",
    "npm": "11.x"
  },
  "bin": {
    "yar": "dist/src/cli.js"
  },
  "files": [
    "dist/src",
    "dist/viewer",
    "README.md",
    "ARCHITECTURE.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && tsc -p tsconfig.viewer.json && node scripts/copy-viewer-assets.mjs",
    "check:history": "node scripts/check-controlled-history.mjs",
    "check:safety": "node scripts/check-public-safety.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.viewer.json --noEmit",
    "test:node": "node --test --test-reporter=spec 'dist/test/**/*.test.js'",
    "test:browser": "tsc -p tsconfig.browser-test.json --noEmit && vitest run",
    "test": "npm run build && npm run test:node && npm run test:browser",
    "check": "npm run typecheck && npm test && npm run build && npm run check:history && npm run check:safety",
    "verify:github-settings": "node scripts/verify-github-settings.mjs"
  },
  "dependencies": {
    "commander": "15.0.0",
    "fast-xml-parser": "5.11.0",
    "node-unrar-js": "2.0.2",
    "sharp": "0.35.3",
    "yauzl": "3.4.0",
    "yazl": "3.3.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/jsdom": "30.0.0",
    "@types/node": "26.2.0",
    "@types/yauzl": "3.4.0",
    "@types/yazl": "3.3.1",
    "jsdom": "30.1.0",
    "typescript": "7.0.2",
    "vitest": "5.0.1"
  },
  "packageManager": "npm@11.19.1",
  "allowScripts": {
    "sharp@0.35.3": true,
    "fsevents@2.3.3": false
  }
}
