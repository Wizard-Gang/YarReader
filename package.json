{
  "name": "yarreader",
  "version": "1.1.0",
  "private": true,
  "description": "Crash-recoverable publication ingestion and portable static reader.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": "26.x",
    "npm": "12.x"
  },
  "bin": {
    "yar": "dist/src/cli.js"
  },
  "files": [
    "dist/src",
    "dist/viewer",
    "README.md",
    "ARCHITECTURE.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && vite build --config vite.viewer.config.ts",
    "check:history": "node scripts/check-controlled-history.mjs",
    "check:safety": "node scripts/check-public-safety.mjs",
    "check:baseline": "node scripts/check-repository-baseline.mjs",
    "audit:dependencies": "node scripts/audit-dependencies.mjs",
    "security:dependency-advisories": "npm run audit:dependencies",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.viewer.json --noEmit && tsc -p tsconfig.browser-test.json --noEmit",
    "test:node": "node --test --test-reporter=spec 'dist/test/**/*.test.js'",
    "test:browser": "tsc -p tsconfig.browser-test.json --noEmit && vitest run",
    "test": "npm run build && npm run test:node && npm run test:settings && npm run test:release && npm run test:audit-policy && npm run test:browser",
    "check": "npm run typecheck && npm test && npm run check:history && npm run check:safety && npm run check:baseline",
    "verify:github-settings": "node scripts/verify-github-settings.mjs",
    "apply:github-settings": "node scripts/apply-github-settings.mjs",
    "test:github-settings": "npm run test:settings",
    "dev": "vite --config vite.viewer.config.ts",
    "test:settings": "node --test --test-reporter=spec test/github-settings-policy.test.mjs",
    "test:release": "node --test --test-reporter=spec test/release-identity.test.mjs",
    "test:audit-policy": "node --test --test-reporter=spec test/dependency-advisory-policy.test.mjs"
  },
  "dependencies": {
    "commander": "15.0.0",
    "fast-xml-parser": "5.11.1",
    "node-unrar-js": "2.0.2",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "sharp": "0.35.4",
    "yauzl": "3.4.0",
    "yazl": "3.3.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/jsdom": "30.0.0",
    "@types/node": "26.6.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/yauzl": "3.4.0",
    "@types/yazl": "3.3.1",
    "jsdom": "30.1.1",
    "typescript": "7.0.2",
    "vite": "8.3.1",
    "vitest": "5.0.2"
  },
  "packageManager": "npm@12.1.0",
  "allowScripts": {
    "fsevents@2.3.3": false,
    "sharp@0.35.4": true
  }
}
